# Copy this to .env and fill in your keys
# cp .env.example .env

# ── Ollama (FREE — fully local, no internet needed) ──────────────────────────
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Then:    ollama pull llama3.2:3b
NEXUS_OLLAMA_MODEL=llama3.2:3b   # change to any pulled model
OLLAMA_HOST=http://localhost:11434

# ── Gemini (FREE — get key at https://aistudio.google.com/apikey) ─────────────
GEMINI_API_KEY=your-gemini-key-here
NEXUS_GEMINI_MODEL=gemini-2.0-flash-lite   # fastest free model
# Other free Gemini models:
# gemini-2.0-flash        (better quality, same free tier)
# gemini-1.5-flash        (reliable, widely tested)
# gemini-1.5-flash-8b     (smallest, fastest)

# ── Anthropic (paid) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key-here
NEXUS_LLM_MODEL=claude-3-haiku-20240307

# ── OpenAI (paid) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key-here

# ── Provider selection ────────────────────────────────────────────────────────
# Which LLM backs the attacker agents?
# Options: mock | ollama | gemini | anthropic | openai
NEXUS_LLM_PROVIDER=ollama

# ── Simulation defaults ───────────────────────────────────────────────────────
NEXUS_SIM_SEED=42
NEXUS_NUM_USERS=50
NEXUS_NUM_HOSTS=20

# ── Storage ───────────────────────────────────────────────────────────────────
NEXUS_CHROMA_PATH=./data/chroma
NEXUS_SQLITE_PATH=./data/nexus.db
